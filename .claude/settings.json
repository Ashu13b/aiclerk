{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .context-kit/ck session 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .context-kit/ck hint 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
